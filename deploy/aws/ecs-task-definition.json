{
  "family": "storefront-voice-ops",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/storefront-voice-ops-execution",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/storefront-voice-ops-task",
  "volumes": [
    {
      "name": "data",
      "efsVolumeConfiguration": {
        "fileSystemId": "EFS_FILE_SYSTEM_ID",
        "transitEncryption": "ENABLED",
        "rootDirectory": "/storefront"
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "app",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/storefront-voice-ops:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "HOST", "value": "0.0.0.0" },
        { "name": "AUTH_MODE", "value": "demo" },
        { "name": "DEMO_MODE", "value": "1" },
        { "name": "ALLOWED_ORIGINS", "value": "*" },
        { "name": "STORE_PROVIDER", "value": "mock" },
        { "name": "DB_PATH", "value": "/app/data/storefront.sqlite" },
        { "name": "USE_BEDROCK", "value": "0" }
      ],
      "mountPoints": [
        {
          "sourceVolume": "data",
          "containerPath": "/app/data",
          "readOnly": false
        }
      ],
      "readonlyRootFilesystem": false,
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/storefront-voice-ops",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
