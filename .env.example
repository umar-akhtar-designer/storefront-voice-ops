# ---- HTTP server ----
PORT=3000
# HOST defaults to 127.0.0.1 in development and 0.0.0.0 in production.
HOST=127.0.0.1
LOG_LEVEL=info
NODE_ENV=development

# ---- MCP auth ----
# AUTH_MODE=demo  -> read tools open, writes restricted to the disposable demo dataset.
# AUTH_MODE=linked -> OAuth 2.1 (PKCE S256) access tokens validated against MCP_CANONICAL_URI.
AUTH_MODE=demo
# Bearer token required on /mcp in demo mode (leave blank to disable the check locally).
MCP_AUTH_TOKEN=
# Canonical URI of this MCP server, used as the OAuth "resource" / audience value.
MCP_CANONICAL_URI=http://localhost:3000/mcp
# Comma-separated list of allowed Origin header values for /mcp (DNS-rebinding protection).
ALLOWED_ORIGINS=http://localhost:3000

# ---- Safety limits ----
CONFIRM_TTL_SECONDS=120
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
REQUEST_BODY_LIMIT=256kb

# ---- Store provider ----
# mock | shopify | woocommerce
STORE_PROVIDER=mock
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-01
WOO_BASE_URL=
WOO_KEY=
WOO_SECRET=

# ---- Persistence ----
DB_PATH=./data/storefront.sqlite

# ---- Amazon Bedrock ----
USE_BEDROCK=0
# Kill switch: set to 1 to force Bedrock off even if USE_BEDROCK=1.
BEDROCK_KILL_SWITCH=0
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
